KaylethsVillage:
SetBackground(0x1)
CHECK_ACTIVE
SVAL s1 Schwarze
BNE 0 sC s1 //sC means the result, s1 is the "saved" unit. So in this case, visiting unit (Schwarze) is s1, then sC confirms if he is.
    Text(KaylethsVillageSchwarzeText)
	ENUT KaylethVisitedCh1Flag
    GOTO 2
LABEL 0
CHECK_ACTIVE
SVAL s1 Noir
BNE 1 sC s1
    Text(KaylethsVillageNoirText)
	ENUT KaylethVisitedCh1Flag
    GOTO 2
LABEL 1
	Text(KaylethsVillageText)
LABEL 2
EndConvo
GiveItem(Elixir,-1)
GiveItem(Vulnerary,-1)
NoFade;ENDA

ArtemisasVillage:
SetBackground(0x5)
CHECK_ACTIVE
SVAL s1 Artemisa
BNE 0 sC s1
	Text(ArtemisaVillageSpecificText)
	GOTO 2
LABEL 0 // ^ If Artemisa visits the village.
	Text(ArtemisaVillageGenericText)
	GOTO 2
LABEL 1 // ^ If someone else visits the village. Why the hell do LABELs work this way?
LABEL 2
EndConvo
GiveItem(BraveLance,-1)
NoFade;ENDA

WilliamBallistaArrive:
CHECK_INAREA WilliamCh1 [10,3] [1,1]
BEQ 69 sC s0
	ASMC 0x8022739
	ENUN
	SET_ACTIVE 0x0
	Text(WilliamFiresBallista)
	FAWI 8
		SOUN 0xD0
		STAL 6
		SOUN 0xD0
		STAL 6
		SOUN 0xD0
		STAL 6
	FAWU 8
	CURSOR RuneVelka
	STAL 60
	REMOVE_CURSORS
	Text(JanusMageTPsIn)
	WARPIN [11,1]
		LOAD1 1 JanusMageTeleport
	ENDWARP
	MOVE 15 RuneVelka [6,1]
	StartBattle
	SetScriptedBattle(100,19,15,0xFF,0xFF,0xFF)
	NormalDamage(0,19)
	EndAttack
	FIGHT Janus RuneVelka Blizzard False
	WARPOUT [11,1]
		DISA Janus
	ENDWARP
	WARPOUT [6,1]
		DISA RuneVelka
	ENDWARP
	WARPIN [6,1]
		LOAD1 1 JanusMageTeleport2
	ENDWARP
	WARPIN [11,1]
		LOAD1 1 RuneVelkaTeleport
		SVAL s1 26
		SET_HP RuneVelka
	ENDWARP
	Text(DefensesAreDown)
	CALL EndingScene
LABEL 69
NoFade;ENDA

